# syntax=docker/dockerfile:1
# Generic agent image. The manager starts one container per deployed agent,
# mounting the agent's config (mode 0600) at /agent/config.json. The worker
# polls the manager for tasks and the git host for mentions/assigned work,
# calls the configured LLM provider, and streams events back to the manager.
#
# On top of the worker it ships the coding CLIs (claude, codex, vibe, qwen),
# the git hosts' CLIs (gh, glab) and the toolchains agents need to test their
# work on a checkout (Go, Node/npm). Multi-stage: every download happens in a
# build stage, so caches and leftovers never reach the final image, which only
# has the runtimes and CLIs. Its size is in the README's "Agent image" section;
# CI prints it on every build.
#
# The CLIs never update themselves: their built-in update checks are turned
# off in the image (the ENV and config files below), so a version pin is what
# actually runs.
#
# Every version is a build arg, so a bump is a one-line change; the download
# checksums sit next to them and must be bumped with the version:
#   docker build -f deploy/Dockerfile.agent --build-arg CLAUDE_CODE_VERSION=2.1.320 .
#
# The build targets the host architecture: assets and checksums are picked per
# Docker's TARGETARCH (amd64 or arm64), declared in each stage that uses it.

# --- Node.js and the Node-based coding CLIs --------------------------------
# Node 22, as in CI and Dockerfile.manager. The CLIs are installed into the
# image's global node_modules; their npm cache stays in this stage. npm picks
# the right binaries for the architecture on its own.
FROM node:22-bookworm-slim AS node-clis
ARG CLAUDE_CODE_VERSION=2.1.318
ARG QWEN_CODE_VERSION=0.25.1
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
RUN npm install -g --omit=dev \
      @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
      @qwen-code/qwen-code@${QWEN_CODE_VERSION} \
 && npm cache clean --force

# --- codex CLI -------------------------------------------------------------
# A native binary from its GitHub release (no Node involved). The tarball
# holds one file named after the target triple, hence the mv. Both
# architectures are downloaded (each with its checksum) and the one for
# TARGETARCH is kept.
FROM python:3.14-slim AS codex-cli
ARG TARGETARCH
ARG CODEX_VERSION=0.166.0
ARG CODEX_SHA256_AMD64=a0bf572d2f93f056c6712a6da348e96078dc84f3885fd7be67807ef389cb3978
ARG CODEX_SHA256_ARM64=94eb707605ec2646b2e05b7edf7c4e7b3ccf02b16237c34ae9beb8cfb7f810a9
ADD --checksum=sha256:${CODEX_SHA256_AMD64} https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-x86_64-unknown-linux-musl.tar.gz /tmp/codex-amd64.tar.gz
ADD --checksum=sha256:${CODEX_SHA256_ARM64} https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-aarch64-unknown-linux-musl.tar.gz /tmp/codex-arm64.tar.gz
RUN tar -xzf /tmp/codex-${TARGETARCH}.tar.gz -C /tmp \
 && mv /tmp/codex-*-unknown-linux-musl /usr/local/bin/codex \
 && rm -f /tmp/codex-*.tar.gz

# --- gh / glab --------------------------------------------------------------
# The git hosts' CLIs as debs from their releases: the CLI engines don't have
# Doppio's create_pr tool, they open pull/merge requests with these. Both
# architectures are downloaded (each with its checksum), the deb for
# TARGETARCH is unpacked, and only the self-contained binary is copied on
# (they only depend on git, which the final image already ships).
FROM python:3.14-slim AS git-host-clis
ARG TARGETARCH
ARG GH_VERSION=2.76.2
ARG GLAB_VERSION=1.128.0
ARG GH_SHA256_AMD64=2958aa0cf0a2a82790913058667bf5a8b67fe0ecdd0d13d5ffe78d90adb04602
ARG GH_SHA256_ARM64=8a4728b3619fc4b21ad74334a9642776a45afe3a473364141d31c09b0452e40d
ARG GLAB_SHA256_AMD64=b42db1c339cb66df2dbdaf190b8c4e359cb2ea3f7ac53e46302b04777f2cf405
ARG GLAB_SHA256_ARM64=88e68a179fc25c3751e7950aa4b1b47b184cade590b70d9ca4aafff6648c655e
ADD --checksum=sha256:${GH_SHA256_AMD64} https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.deb /tmp/gh-amd64.deb
ADD --checksum=sha256:${GH_SHA256_ARM64} https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.deb /tmp/gh-arm64.deb
ADD --checksum=sha256:${GLAB_SHA256_AMD64} https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.deb /tmp/glab-amd64.deb
ADD --checksum=sha256:${GLAB_SHA256_ARM64} https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_arm64.deb /tmp/glab-arm64.deb
RUN dpkg-deb -x /tmp/gh-${TARGETARCH}.deb /tmp/gh \
 && dpkg-deb -x /tmp/glab-${TARGETARCH}.deb /tmp/glab \
 && mv /tmp/gh/usr/bin/gh /tmp/glab/usr/bin/glab /usr/local/bin/ \
 && rm -rf /tmp/gh /tmp/glab /tmp/gh-*.deb /tmp/glab-*.deb

# --- Go toolchain -----------------------------------------------------------
# The Go toolchain agents run `go test ./...` with (the version go.mod builds
# with). Both architectures are downloaded (each with its checksum), the one
# for TARGETARCH is unpacked, and the archives are never copied on.
FROM python:3.14-slim AS go-toolchain
ARG TARGETARCH
ARG GO_VERSION=1.26.7
ARG GO_SHA256_AMD64=ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca
ARG GO_SHA256_ARM64=5a4ec883379d51ee9ce1040d5e87f8d35e20387574dd8c947feb01eabc3c1b37
ADD --checksum=sha256:${GO_SHA256_AMD64} https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz /tmp/go-amd64.tar.gz
ADD --checksum=sha256:${GO_SHA256_ARM64} https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz /tmp/go-arm64.tar.gz
RUN tar -C /usr/local -xzf /tmp/go-${TARGETARCH}.tar.gz \
 && rm -f /tmp/go-*.tar.gz

# --- vibe (Mistral Vibe) ----------------------------------------------------
# A Python package, installed against the same Python as the final image. pip
# picks the wheel for the architecture on its own.
FROM python:3.14-slim AS vibe-cli
ARG VIBE_VERSION=3.0.4
RUN pip install --no-cache-dir mistral-vibe==${VIBE_VERSION}

# --- Final image -----------------------------------------------------------
FROM python:3.14-slim
# ca-certificates: the worker and the CLIs talk HTTPS to the manager, the git
# host and the model API. git: the workspace is a git checkout.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Node, npm and the Node-based CLIs (agents run `npm ci && npm run check` on
# a checkout).
COPY --from=node-clis /usr/local/bin /usr/local/bin
COPY --from=node-clis /usr/local/lib/node_modules /usr/local/lib/node_modules
# gh / glab, unpacked from their debs above.
COPY --from=git-host-clis /usr/local/bin/gh /usr/local/bin/gh
COPY --from=git-host-clis /usr/local/bin/glab /usr/local/bin/glab
# The Go toolchain (agents run `go test ./...` on a checkout).
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
# codex and vibe (all three vibe entry points: the launcher points the Rust
# CLI at the vibe-app-server script next to itself).
COPY --from=codex-cli /usr/local/bin/codex /usr/local/bin/codex
COPY --from=vibe-cli /usr/local/bin/vibe* /usr/local/bin/
# vibe's Python package and its dependencies: the entry points above import
# them (same Python 3.14 as this stage, so the path matches).
COPY --from=vibe-cli /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
# No self-updates. Containers run as root (HOME=/root), so each CLI reads its
# own home config; qwen's system-wide file lives in /etc and wins over any
# user settings.
#   claude: DISABLE_AUTOUPDATER (its own env var).
#   codex:  check_for_update_on_startup in ~/.codex/config.toml.
#   vibe:   enable_update_checks / enable_auto_update in ~/.vibe/config.toml.
#   qwen:   general.enableAutoUpdate in /etc/qwen-code/settings.json.
ENV DISABLE_AUTOUPDATER=1
RUN mkdir -p /root/.codex /root/.vibe /etc/qwen-code \
 && printf 'check_for_update_on_startup = false\n' > /root/.codex/config.toml \
 && printf 'enable_update_checks = false\nenable_auto_update = false\n' > /root/.vibe/config.toml \
 && printf '{ "general": { "enableAutoUpdate": false } }\n' > /etc/qwen-code/settings.json \
 && chmod 0644 /root/.codex/config.toml /root/.vibe/config.toml /etc/qwen-code/settings.json
WORKDIR /agent
COPY deploy/agent/agent_worker.py /agent/agent_worker.py
ENTRYPOINT ["python3", "-u", "/agent/agent_worker.py"]
