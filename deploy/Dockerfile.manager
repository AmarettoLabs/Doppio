# syntax=docker/dockerfile:1
# Manager image: builds the Svelte SPA and the Go API, then serves both.
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS server
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/doppio ./cmd/server

FROM alpine:3.21
# docker-cli: the manager controls agent containers through the mounted socket
RUN apk add --no-cache ca-certificates docker-cli
WORKDIR /app
COPY --from=server /bin/doppio /usr/local/bin/doppio
COPY --from=web /web/build ./web-build
ENV ADDR=:8080
ENV STATIC_DIR=/app/web-build
ENV DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["doppio"]
